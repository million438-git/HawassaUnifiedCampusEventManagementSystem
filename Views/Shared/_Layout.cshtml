@{
    var currentController =
        ViewContext.RouteData.Values["controller"]?.ToString();

    var currentAction =
        ViewContext.RouteData.Values["action"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <meta http-equiv="X-UA-Compatible"
          content="IE=edge" />

    <title>
        @ViewData["Title"] - HUCEMS
    </title>

    <meta name="description"
          content="Hawassa Unified Campus Event Management System - A centralized platform for campus events, community activities, announcements and student engagement." />

    <meta name="keywords"
          content="Hawassa University, HUCEMS, campus events, university events, student events, campus management, Ethiopia" />

    <meta name="author"
          content="Hawassa Unified Campus Event Management System" />

    <meta name="theme-color"
          content="#0f172a" />


    <!-- =====================================================
         BOOTSTRAP
         ===================================================== -->

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />


    <!-- =====================================================
         BOOTSTRAP ICONS
         ===================================================== -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />


    <!-- =====================================================
         GLOBAL CSS
         ===================================================== -->

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />


    <!-- =====================================================
         ACCOUNT CSS
         ===================================================== -->

    <link rel="stylesheet"
          href="~/css/account.css"
          asp-append-version="true" />


    <!-- =====================================================
         RESPONSIVE CSS
         ===================================================== -->

    <link rel="stylesheet"
          href="~/css/responsive.css"
          asp-append-version="true" />


    <!-- =====================================================
         PAGE SPECIFIC CSS
         ===================================================== -->

    @await RenderSectionAsync(
        "Styles",
        required: false
    )

</head>


<body>

    <!-- =====================================================
         HEADER
         ===================================================== -->

    <header>

        <nav class="navbar navbar-expand-lg">

            <div class="container">


                <!-- =================================================
                     BRAND
                     ================================================= -->

                <a class="navbar-brand"
                   asp-controller="Home"
                   asp-action="Index"
                   aria-label="HUCEMS Home">

                    <span class="brand-icon">
                        🎓
                    </span>

                    <span class="brand-text">
                        HUCEMS
                    </span>

                </a>


                <!-- =================================================
                     MOBILE MENU
                     ================================================= -->

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>


                <!-- =================================================
                     NAVIGATION
                     ================================================= -->

                <div class="collapse navbar-collapse"
                     id="mainNavbar">


                    <!-- =================================================
                         MAIN NAVIGATION
                         ================================================= -->

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">


                        <!-- HOME -->

                        <li class="nav-item">

                            <a class="nav-link @(currentController == "Home" && currentAction == "Index" ? "active" : "")"
                               asp-controller="Home"
                               asp-action="Index">

                                <i class="bi bi-house-door"></i>

                                <span>
                                    Home
                                </span>

                            </a>

                        </li>


                        <!-- EVENTS -->

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <!-- DASHBOARD -->
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Dashboard" ? "active" : "")"
                                   asp-controller="Dashboard"
                                   asp-action="Index">
                                    <i class="bi bi-speedometer2"></i>
                                    <span>Dashboard</span>
                                </a>
                            </li>

                            @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin") || User.IsInRole("ADMIN") || User.IsInRole("SUPERADMIN"))
                            {
                                <!-- ADMIN CENTER (Visible to Administrators only) -->
                                <li class="nav-item">
                                    <a class="nav-link @(currentController == "Admin" ? "active" : "")"
                                       asp-controller="Admin"
                                       asp-action="Index">
                                        <i class="bi bi-shield-lock"></i>
                                        <span>Admin</span>
                                    </a>
                                </li>
                            }
                        }

                        <!-- EVENTS -->
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Events" && currentAction == "Index" ? "active" : "")"
                               asp-controller="Events"
                               asp-action="Index">
                                <i class="bi bi-calendar-event"></i>
                                <span>Events</span>
                            </a>
                        </li>


                        <!-- SEARCH EVENTS -->

                        <li class="nav-item">

                            <a class="nav-link @(currentController == "Events" && currentAction == "Search" ? "active" : "")"
                               asp-controller="Events"
                               asp-action="Search">

                                <i class="bi bi-search"></i>

                                <span>
                                    Search
                                </span>

                            </a>

                        </li>


                        <!-- COMMUNITY -->

                        <li class="nav-item">

                            <a class="nav-link @(currentController == "Community" ? "active" : "")"
                               asp-controller="Community"
                               asp-action="Index">

                                <i class="bi bi-people"></i>

                                <span>
                                    Community
                                </span>

                            </a>

                        </li>


                        <!-- JOBS -->

                        <li class="nav-item">

                            <a class="nav-link @(currentController == "Jobs" ? "active" : "")"
                               asp-controller="Jobs"
                               asp-action="Index">

                                <i class="bi bi-briefcase"></i>

                                <span>
                                    Jobs
                                </span>

                            </a>

                        </li>


                        <!-- CALENDAR -->

                        <li class="nav-item">

                            <a class="nav-link @(currentController == "Calendar" ? "active" : "")"
                               asp-controller="Calendar"
                               asp-action="Index">

                                <i class="bi bi-calendar3"></i>

                                <span>
                                    Calendar
                                </span>

                            </a>

                        </li>


                        <!-- ABOUT -->

                        <li class="nav-item">

                            <a class="nav-link @(currentController == "Home" && currentAction == "About" ? "active" : "")"
                               asp-controller="Home"
                               asp-action="About">

                                <i class="bi bi-info-circle"></i>

                                <span>
                                    About
                                </span>

                            </a>

                        </li>

                    </ul>


                    <!-- =================================================
                         RIGHT NAVIGATION
                         ================================================= -->

                    <ul class="navbar-nav align-items-lg-center">

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole("Faculty") || User.IsInRole("Staff") || User.IsInRole("Organization") || User.IsInRole("Club") || User.IsInRole("Admin") || User.IsInRole("SuperAdmin") || User.IsInRole("FACULTY") || User.IsInRole("STAFF") || User.IsInRole("ORGANIZATION") || User.IsInRole("ADMIN") || User.IsInRole("SUPERADMIN"))
                            {
                                <!-- =================================================
                                     CREATE EVENT (Organizers & Staff Only)
                                     ================================================= -->
                                <li class="nav-item me-lg-3 mb-2 mb-lg-0">
                                    <a class="btn btn-primary btn-sm px-3"
                                       asp-controller="Events"
                                       asp-action="Create">
                                        <i class="bi bi-plus-lg"></i>
                                        <span>Create Event</span>
                                    </a>
                                </li>
                            }

                            <!-- =================================================
                                 AUTHENTICATED ACCOUNT DROPDOWN
                                 ================================================= -->
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center gap-2"
                                   href="#"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">
                                    <i class="bi bi-person-circle fs-5 text-primary"></i>
                                    <span class="fw-semibold">@(User.Identity.Name ?? "My Account")</span>
                                </a>

                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                    <li class="dropdown-header small text-muted text-truncate px-3">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <span><i class="bi bi-person-check me-1"></i>Logged in as</span>
                                            @{
                                                var roleVal = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Student";
                                                var roleBadgeBg = roleVal switch {
                                                    "SuperAdmin" => "bg-dark text-white",
                                                    "Admin" => "bg-danger text-white",
                                                    "Faculty" => "bg-purple text-white",
                                                    "Staff" => "bg-success text-white",
                                                    "Organization" => "bg-warning text-dark",
                                                    _ => "bg-primary text-white"
                                                };
                                            }
                                            <span class="badge @roleBadgeBg small" style="font-size: 10px;">@roleVal</span>
                                        </div>
                                        <div class="text-dark fw-bold">@(User.Identity.Name ?? "Student")</div>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <a class="dropdown-item fw-semibold text-primary"
                                           asp-controller="Dashboard"
                                           asp-action="Index">
                                            <i class="bi bi-speedometer2 me-2 text-primary"></i>
                                            @roleVal Dashboard
                                        </a>
                                    </li>
                                    @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin") || User.IsInRole("ADMIN") || User.IsInRole("SUPERADMIN"))
                                    {
                                        <li>
                                            <a class="dropdown-item text-danger fw-semibold"
                                               asp-controller="Admin"
                                               asp-action="Index">
                                                <i class="bi bi-shield-lock me-2 text-danger"></i>
                                                Admin Control Panel
                                            </a>
                                        </li>
                                    }
                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Account"
                                           asp-action="Profile">
                                            <i class="bi bi-person me-2 text-secondary"></i>
                                            My Profile
                                        </a>
                                    </li>
                                    @if (User.IsInRole("Faculty") || User.IsInRole("Staff") || User.IsInRole("Organization") || User.IsInRole("Club") || User.IsInRole("Admin") || User.IsInRole("SuperAdmin") || User.IsInRole("FACULTY") || User.IsInRole("STAFF") || User.IsInRole("ORGANIZATION") || User.IsInRole("ADMIN") || User.IsInRole("SUPERADMIN"))
                                    {
                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="Events"
                                               asp-action="Create">
                                                <i class="bi bi-plus-circle me-2 text-success"></i>
                                                Create Event
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="Events"
                                               asp-action="MyEvents">
                                                <i class="bi bi-calendar-check me-2 text-info"></i>
                                                My Organized Events
                                            </a>
                                        </li>
                                    }
                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Jobs"
                                           asp-action="MyApplications">
                                            <i class="bi bi-briefcase me-2 text-primary"></i>
                                            My Job Applications
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <a class="dropdown-item text-danger"
                                           asp-controller="Account"
                                           asp-action="Logout">
                                            <i class="bi bi-box-arrow-right me-2"></i>
                                            Logout
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <!-- =================================================
                                 GUEST / NOT REGISTERED STATE
                                 ================================================= -->
                            <li class="nav-item me-lg-2 mb-2 mb-lg-0">
                                <a class="nav-link"
                                   asp-controller="Account"
                                   asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i>
                                    <span>Login</span>
                                </a>
                            </li>

                            <li class="nav-item mb-2 mb-lg-0">
                                <a class="btn btn-outline-primary btn-sm px-3"
                                   asp-controller="Account"
                                   asp-action="Register"
                                   asp-route-returnUrl="/Events/Create">
                                    <i class="bi bi-person-plus me-1"></i>
                                    <span>Register</span>
                                </a>
                            </li>
                        }

                    </ul>

                </div>

            </div>

        </nav>

    </header>


    <!-- =====================================================
         MAIN CONTENT
         ===================================================== -->

    <main role="main">

        @RenderBody()

    </main>


    <!-- =====================================================
         FOOTER
         ===================================================== -->

    <footer class="site-footer">

        <div class="container">

            <div class="row g-4">


                <!-- =================================================
                     HUCEMS INFORMATION
                     ================================================= -->

                <div class="col-lg-4 col-md-6">

                    <h5>

                        <span class="footer-brand-icon">
                            🎓
                        </span>

                        HUCEMS

                    </h5>


                    <p>

                        Hawassa Unified Campus Event Management
                        System connects students, staff, clubs,
                        and university communities through one
                        centralized platform.

                    </p>


                    <p class="footer-description">

                        Discover events, connect with your campus
                        community, create activities, and stay
                        informed about what is happening around
                        the university.

                    </p>

                </div>


                <!-- =================================================
                     QUICK LINKS
                     ================================================= -->

                <div class="col-lg-2 col-md-6">

                    <h5>
                        Quick Links
                    </h5>


                    <ul class="list-unstyled">


                        <li class="mb-2">

                            <a asp-controller="Home"
                               asp-action="Index">

                                <i class="bi bi-house me-1"></i>

                                Home

                            </a>

                        </li>


                        <li class="mb-2">

                            <a asp-controller="Events"
                               asp-action="Index">

                                <i class="bi bi-calendar-event me-1"></i>

                                Events

                            </a>

                        </li>


                        <!-- SEARCH -->

                        <li class="mb-2">

                            <a asp-controller="Events"
                               asp-action="Search">

                                <i class="bi bi-search me-1"></i>

                                Search Events

                            </a>

                        </li>


                        <li class="mb-2">

                            <a asp-controller="Community"
                               asp-action="Index">

                                <i class="bi bi-people me-1"></i>

                                Community

                            </a>

                        </li>


                        <li class="mb-2">

                            <a asp-controller="Jobs"
                               asp-action="Index">

                                <i class="bi bi-briefcase me-1"></i>

                                Jobs & Careers

                            </a>

                        </li>


                        <li class="mb-2">

                            <a asp-controller="Calendar"
                               asp-action="Index">

                                <i class="bi bi-calendar3 me-1"></i>

                                Calendar

                            </a>

                        </li>


                        <li class="mb-2">

                            <a asp-controller="Home"
                               asp-action="About">

                                <i class="bi bi-info-circle me-1"></i>

                                About

                            </a>

                        </li>

                    </ul>

                </div>


                <!-- =================================================
                     EVENTS
                     ================================================= -->

                <div class="col-lg-3 col-md-6">

                    <h5>
                        Events
                    </h5>


                    <ul class="list-unstyled">


                        <!-- DASHBOARD -->
                        <li class="mb-2">
                            <a asp-controller="Dashboard"
                               asp-action="Index">
                                <i class="bi bi-speedometer2 me-1"></i>
                                Campus Dashboard
                            </a>
                        </li>

                        <!-- ALL EVENTS -->
                        <li class="mb-2">
                            <a asp-controller="Events"
                               asp-action="Index">
                                <i class="bi bi-calendar-event me-1"></i>
                                All Events
                            </a>
                        </li>


                        <!-- SEARCH EVENTS -->

                        <li class="mb-2">

                            <a asp-controller="Events"
                               asp-action="Search">

                                <i class="bi bi-search me-1"></i>

                                Search Events

                            </a>

                        </li>


                        <!-- CREATE EVENT -->
                        <li class="mb-2">
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <a asp-controller="Events"
                                   asp-action="Create">
                                    <i class="bi bi-plus-circle me-1"></i>
                                    Create Event
                                </a>
                            }
                            else
                            {
                                <a asp-controller="Account"
                                   asp-action="Register"
                                   asp-route-returnUrl="/Events/Create">
                                    <i class="bi bi-person-plus me-1"></i>
                                    Register to Create Event
                                </a>
                            }
                        </li>


                        <!-- MY EVENTS -->

                        <li class="mb-2">

                            <a asp-controller="Events"
                               asp-action="MyEvents">

                                <i class="bi bi-person-check me-1"></i>

                                My Events

                            </a>

                        </li>


                        <!-- CATEGORIES -->

                        <li class="mb-2">

                            <a asp-controller="Events"
                               asp-action="Categories">

                                <i class="bi bi-grid me-1"></i>

                                Categories

                            </a>

                        </li>

                    </ul>

                </div>


                <!-- =================================================
                     COMMUNITY
                     ================================================= -->

                <div class="col-lg-3 col-md-6">

                    <h5>
                        Community
                    </h5>


                    <ul class="list-unstyled">


                        <li class="mb-2">

                            <a asp-controller="Community"
                               asp-action="FindPeople">

                                <i class="bi bi-person-plus me-1"></i>

                                Find People

                            </a>

                        </li>


                        <li class="mb-2">

                            <a asp-controller="Community"
                               asp-action="Friends">

                                <i class="bi bi-people me-1"></i>

                                Friends

                            </a>

                        </li>


                        <li class="mb-2">

                            <a asp-controller="Community"
                               asp-action="Posts">

                                <i class="bi bi-chat-left-text me-1"></i>

                                Community Posts

                            </a>

                        </li>


                        <li class="mb-2">

                            <a asp-controller="Community"
                               asp-action="CreatePost">

                                <i class="bi bi-pencil-square me-1"></i>

                                Create Post

                            </a>

                        </li>

                    </ul>

                </div>

            </div>


            <!-- =====================================================
                 FOOTER DIVIDER
                 ===================================================== -->

            <hr class="footer-divider" />


            <!-- =====================================================
                 FOOTER BOTTOM
                 ===================================================== -->

            <div class="footer-bottom">


                <div>

                    <p class="mb-1">

                        &copy;

                        <span class="current-year">
                            @DateTime.Now.Year
                        </span>

                        HUCEMS.

                        All rights reserved.

                    </p>


                    <small>

                        Hawassa University Campus
                        Event Management System

                    </small>

                </div>


                <!-- LEGAL -->

                <div class="footer-legal">

                    <a asp-controller="Home"
                       asp-action="About">

                        About

                    </a>


                    <span>
                        •
                    </span>


                    <a asp-controller="Home"
                       asp-action="Privacy">

                        Privacy

                    </a>

                </div>

            </div>

        </div>

    </footer>


    <!-- =====================================================
         JAVASCRIPT
         ===================================================== -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    <script src="~/js/account.js"
            asp-append-version="true"></script>


    @await RenderSectionAsync(
        "Scripts",
        required: false
    )

</body>

</html>