@{
    ViewData["Title"] = "Login | HUCEMS";
}

<link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />

<div class="account-page">

    <div class="account-card shadow-lg">

        <div class="account-icon">🔐</div>

        <h1>Welcome Back</h1>

        <p class="account-description">
            Sign in to access your role-based campus dashboard.
        </p>

        @if (ViewBag.ReturnUrl != null && ((string)ViewBag.ReturnUrl).Contains("Create", StringComparison.OrdinalIgnoreCase))
        {
            <div class="alert alert-info py-2 px-3 mb-3 small rounded-3" style="background-color: #e0f2fe; color: #0369a1; border: 1px solid #bae6fd;">
                <i class="bi bi-lock-fill me-1"></i>
                Please sign in or <a asp-action="Register" asp-route-returnUrl="@ViewBag.ReturnUrl" class="fw-bold text-decoration-underline" style="color: #0284c7;">create an account</a> to access the event creation page.
            </div>
        }

        @if (ViewBag.Error != null)
        {
            <div class="error-message">
                @ViewBag.Error
            </div>
        }

        <form asp-controller="Account"
              asp-action="Login"
              method="post"
              id="loginForm">

            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

            <div class="form-group">
                <label for="email">Campus Email Address</label>
                <input type="email"
                       id="email"
                       name="email"
                       placeholder="e.g. student@hawassauniversity.edu.et"
                       autocomplete="email"
                       required />
            </div>

            <div class="form-group">
                <label for="password">Password</label>
                <input type="password"
                       id="password"
                       name="password"
                       placeholder="Enter your password"
                       autocomplete="current-password"
                       required />
            </div>

            <div class="password-row">
                <label>
                    <input type="checkbox" id="showPassword" />
                    Show password
                </label>

                <a asp-action="ForgotPassword">
                    Forgot Password?
                </a>
            </div>

            <button type="submit"
                    class="account-button"
                    id="loginButton">
                Sign In & Open Dashboard ➔
            </button>

        </form>

        <!-- QUICK TEST / EVALUATION ROLES HELPER -->
        <div class="demo-roles-panel mt-4 pt-3 border-top">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <small class="text-uppercase fw-bold text-muted" style="font-size: 11px;">
                    <i class="bi bi-stars text-warning me-1"></i> Quick 1-Click Role Login
                </small>
                <span class="badge bg-light text-secondary border small" style="font-size: 10px;">Pass: 123456</span>
            </div>
            <div class="d-flex flex-wrap gap-1">
                <button type="button" class="btn btn-sm btn-outline-primary demo-pill" onclick="fillDemo('student@hawassauniversity.edu.et')">
                    🎓 Student
                </button>
                <button type="button" class="btn btn-sm btn-outline-success demo-pill" onclick="fillDemo('staff@hawassauniversity.edu.et')">
                    💼 Staff
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary demo-pill" onclick="fillDemo('faculty@hawassauniversity.edu.et')">
                    📚 Faculty
                </button>
                <button type="button" class="btn btn-sm btn-outline-warning text-dark demo-pill" onclick="fillDemo('org@hawassauniversity.edu.et')">
                    🌟 Organization
                </button>
                <button type="button" class="btn btn-sm btn-outline-danger demo-pill" onclick="fillDemo('admin@hawassauniversity.edu.et')">
                    🛡️ Admin
                </button>
                <button type="button" class="btn btn-sm btn-outline-dark demo-pill" onclick="fillDemo('superadmin@hawassauniversity.edu.et')">
                    ⚡ SuperAdmin
                </button>
            </div>
        </div>

        <div class="account-footer">
            Don't have an account?
            <a asp-action="Register" asp-route-returnUrl="@ViewBag.ReturnUrl">
                Create Account
            </a>
        </div>

    </div>

</div>

<script src="~/js/login.js" asp-append-version="true"></script>
<script>
    function fillDemo(email) {
        const emailInput = document.getElementById('email');
        const passInput = document.getElementById('password');
        if (emailInput && passInput) {
            emailInput.value = email;
            passInput.value = '123456';
            document.getElementById('loginButton')?.focus();
        }
    }
</script>