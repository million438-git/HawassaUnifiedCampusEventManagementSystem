@model IEnumerable<HawassaUnifiedCampusEventManagementSystem.Models.CommunityUser>

@{
    ViewData["Title"] = "My Friends";
}

<div class="container py-5">

    <h1 class="fw-bold">
        My Friends
    </h1>

    <p class="text-muted mb-4">
        People you are following.
    </p>

    <div class="row g-4">

        @if (!Model.Any())
        {
            <div class="text-center py-5">

                <h3>No friends yet</h3>

                <p class="text-muted">
                    Find people and start following them.
                </p>

                <a asp-action="FindPeople"
                   class="btn btn-primary">
                    Find People
                </a>

            </div>
        }
        else
        {
            @foreach (var user in Model)
            {
                <div class="col-md-4">

                    <div class="community-card">

                        <div class="profile-avatar">
                            @user.FullName.Substring(0, 1)
                        </div>

                        <h4>
                            @user.FullName
                        </h4>

                        <p>
                            @user.Department
                        </p>

                        <a asp-action="Profile"
                           asp-route-id="@user.Id"
                           class="btn btn-primary">
                            View Profile
                        </a>

                    </div>

                </div>
            }
        }

    </div>

</div>