@model IEnumerable<HawassaUnifiedCampusEventManagementSystem.Models.CommunityUser>

@{
    ViewData["Title"] = "Find People";
}

<div class="container py-5">

    <div class="community-header">

        <div>
            <h1>Find People</h1>

            <p class="text-muted">
                Connect with students across campus.
            </p>
        </div>

        <a asp-action="Search"
           class="btn btn-outline-primary">
            🔍 Search
        </a>

    </div>


    <div class="row g-4">

        @foreach (var user in Model)
        {
            <div class="col-lg-4 col-md-6">

                <div class="community-card">

                    <div class="profile-avatar">
                        @user.FullName.Substring(0, 1)
                    </div>

                    <h3>
                        @user.FullName
                    </h3>

                    <p class="text-muted">
                        @@@user.Username
                    </p>

                    <p>
                        🎓 @user.Department
                    </p>

                    <p class="text-muted">
                        @user.Bio
                    </p>

                    <div class="user-stats">

                        <span>
                            <strong>
                                @user.Followers
                            </strong>
                            Followers
                        </span>

                        <span>
                            <strong>
                                @user.Following
                            </strong>
                            Following
                        </span>

                    </div>


                    <div class="mt-3">

                        <a asp-action="Profile"
                           asp-route-id="@user.Id"
                           class="btn btn-outline-primary">
                            Profile
                        </a>

                        @if (user.IsFollowing)
                        {
                            <form asp-action="Unfollow"
                                  asp-route-id="@user.Id"
                                  method="post"
                                  class="d-inline">

                                <button class="btn btn-secondary">
                                    Following
                                </button>

                            </form>
                        }
                        else
                        {
                            <form asp-action="Follow"
                                  asp-route-id="@user.Id"
                                  method="post"
                                  class="d-inline">

                                <button class="btn btn-primary">
                                    Follow
                                </button>

                            </form>
                        }

                    </div>

                </div>

            </div>
        }

    </div>

</div>