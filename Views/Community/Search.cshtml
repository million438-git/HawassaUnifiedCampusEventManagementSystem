@model IEnumerable<HawassaUnifiedCampusEventManagementSystem.Models.CommunityUser>

@{
    ViewData["Title"] = "Search People";
}

<div class="container py-5">

    <h1 class="fw-bold">
        Search People
    </h1>

    <p class="text-muted">
        Search students by name, username or department.
    </p>

    <form asp-action="Search"
          method="get"
          class="my-4">

        <div class="input-group input-group-lg">

            <input name="query"
                   value="@ViewBag.Query"
                   class="form-control"
                   placeholder="Search people..." />

            <button class="btn btn-primary">
                🔍 Search
            </button>

        </div>

    </form>


    <div class="row g-4">

        @foreach (var user in Model)
        {
            <div class="col-lg-4 col-md-6">

                <div class="community-card">

                    <div class="profile-avatar">
                        @(string.IsNullOrWhiteSpace(user.FullName) ? "U" : user.FullName.Substring(0, 1).ToUpper())
                    </div>

                    <h3>
                        @user.FullName
                    </h3>

                    <p>
                        @user.Department
                    </p>

                    <a asp-action="Profile"
                       asp-route-id="@user.Id"
                       class="btn btn-primary">
                        View Profile
                    </a>

                </div>

            </div>
        }

    </div>

</div>