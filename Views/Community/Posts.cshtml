@model IEnumerable<HawassaUnifiedCampusEventManagementSystem.Models.CommunityPost>

@{
    ViewData["Title"] = "Community Posts";
}

<div class="container py-5">

    <div class="community-header">

        <div>
            <h1>Community Posts</h1>

            <p class="text-muted">
                See what is happening around campus.
            </p>
        </div>

        <a asp-action="CreatePost"
           class="btn btn-primary">
            + Create Post
        </a>

    </div>


    <div class="post-list">

        @foreach (var post in Model)
        {
            <div class="community-card post-card">

                <div class="post-author">

                    <div class="profile-avatar small">
                        @post.AuthorName.Substring(0, 1)
                    </div>

                    <div>
                        <strong>
                            @post.AuthorName
                        </strong>

                        <small>
                            @post.CreatedAt.ToString(
                                "MMM dd, yyyy hh:mm tt")
                        </small>
                    </div>

                </div>

                <p class="post-content">
                    @post.Content
                </p>

                <div class="post-actions">

                    ❤️ @post.Likes

                    <span>
                        💬 @post.Comments
                    </span>

                </div>

            </div>
        }

    </div>

</div>