@model HawassaUnifiedCampusEventManagementSystem.Models.CommunityUser

@{
    ViewData["Title"] = "Profile";
}

<div class="container py-5">

    <div class="community-card profile-page">

        <div class="profile-avatar large">
            @(string.IsNullOrWhiteSpace(Model.FullName) ? "U" : Model.FullName.Substring(0, 1).ToUpper())
        </div>

        <h1>
            @Model.FullName
        </h1>

        <p class="text-muted">
            @@@Model.Username
        </p>

        <p>
            🎓 @Model.Department
        </p>

        <p>
            @Model.Bio
        </p>

        <div class="user-stats">

            <span>
                <strong>@Model.Followers</strong>
                Followers
            </span>

            <span>
                <strong>@Model.Following</strong>
                Following
            </span>

        </div>

        <div class="mt-4">

            <a asp-action="FindPeople"
               class="btn btn-secondary">
                Back
            </a>

        </div>

    </div>

</div>