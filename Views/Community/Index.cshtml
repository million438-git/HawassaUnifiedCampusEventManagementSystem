@{
    ViewData["Title"] = "Community";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/community.css"
          asp-append-version="true" />
}

<div class="community-page">

    <div class="community-header">

        <div>
            <h1>Campus Community</h1>

            <p>
                Connect with students, discover people,
                and share campus activities.
            </p>
        </div>

        <a asp-action="FindPeople"
           class="btn btn-primary">
            👥 Find People
        </a>

    </div>


    <div class="community-grid">

        <div class="community-card">

            <h3>👥 Find People</h3>

            <p>
                Discover students from different departments
                and connect with them.
            </p>

            <a asp-action="FindPeople"
               class="btn btn-outline-primary">
                Find People
            </a>

        </div>


        <div class="community-card">

            <h3>🤝 Friends</h3>

            <p>
                View the people you follow and your
                campus connections.
            </p>

            <a asp-action="Friends"
               class="btn btn-outline-primary">
                My Friends
            </a>

        </div>


        <div class="community-card">

            <h3>📝 Community Posts</h3>

            <p>
                Share ideas, announcements and campus
                experiences.
            </p>

            <a asp-action="Posts"
               class="btn btn-outline-primary">
                View Posts
            </a>

        </div>


        <div class="community-card">

            <h3>➕ Create Post</h3>

            <p>
                Share something with the university community.
            </p>

            <a asp-action="CreatePost"
               class="btn btn-primary">
                Create Post
            </a>

        </div>

    </div>

</div>

@section Scripts {
    <script src="~/js/community.js"
            asp-append-version="true"></script>
}