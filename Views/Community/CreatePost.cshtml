@model HawassaUnifiedCampusEventManagementSystem.Models.CommunityPost

@{
    ViewData["Title"] = "Create Post";
}

<div class="container py-5">

    <div class="form-card">

        <h1>Create Community Post</h1>

        <p class="text-muted">
            Share something with the campus community.
        </p>

        <form asp-action="CreatePost"
              method="post">

            <div class="mb-4">

                <label asp-for="Content"
                       class="form-label">
                    What do you want to share?
                </label>

                <textarea asp-for="Content"
                          class="form-control"
                          rows="7"
                          placeholder="Write your post..."></textarea>

                <span asp-validation-for="Content"
                      class="text-danger"></span>

            </div>

            <button type="submit"
                    class="btn btn-primary">
                Publish Post
            </button>

            <a asp-action="Posts"
               class="btn btn-secondary">
                Cancel
            </a>

        </form>

    </div>

</div>