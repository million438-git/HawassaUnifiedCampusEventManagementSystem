@{
    ViewData["Title"] = "SuperAdmin Dashboard";
}

<div class="superadmin-page">

    <!-- Header -->
    <div class="superadmin-header">
        <div>
            <span class="superadmin-label">SYSTEM CONTROL</span>

            <h1>
                SuperAdmin Dashboard
            </h1>

            <p>
                Manage and control the entire HUCEMS platform.
            </p>
        </div>

        <div class="superadmin-user">
            <div class="admin-avatar">
                SA
            </div>

            <div>
                <strong>SuperAdmin</strong>
                <small>System Administrator</small>
            </div>
        </div>
    </div>


    <!-- Statistics -->
    <div class="stats-grid">

        <div class="stat-card">
            <span class="stat-icon">👥</span>
            <div>
                <strong>Users</strong>
                <span>Manage users</span>
            </div>
        </div>

        <div class="stat-card">
            <span class="stat-icon">📅</span>
            <div>
                <strong>Events</strong>
                <span>Manage events</span>
            </div>
        </div>

        <div class="stat-card">
            <span class="stat-icon">🏢</span>
            <div>
                <strong>Organizations</strong>
                <span>Manage organizations</span>
            </div>
        </div>

        <div class="stat-card">
            <span class="stat-icon">📢</span>
            <div>
                <strong>Reports</strong>
                <span>Review reports</span>
            </div>
        </div>

    </div>


    <!-- Management -->
    <section class="management-section">

        <div class="section-heading">
            <h2>System Management</h2>

            <p>
                Control every major part of HUCEMS.
            </p>
        </div>


        <div class="management-grid">

            <!-- Users -->
            <a asp-controller="SuperAdmin"
               asp-action="Users"
               class="management-card">

                <div class="management-icon">👥</div>

                <div>
                    <h3>Users</h3>

                    <p>
                        View, activate, suspend and manage users.
                    </p>
                </div>

                <span>→</span>

            </a>


            <!-- Roles -->
            <a asp-controller="SuperAdmin"
               asp-action="Roles"
               class="management-card">

                <div class="management-icon">🛡️</div>

                <div>
                    <h3>Roles</h3>

                    <p>
                        Create and manage system roles.
                    </p>
                </div>

                <span>→</span>

            </a>


            <!-- Permissions -->
            <a asp-controller="SuperAdmin"
               asp-action="Permissions"
               class="management-card">

                <div class="management-icon">🔐</div>

                <div>
                    <h3>Permissions</h3>

                    <p>
                        Control what each role can do.
                    </p>
                </div>

                <span>→</span>

            </a>


            <!-- Events -->
            <a asp-controller="SuperAdmin"
               asp-action="Events"
               class="management-card">

                <div class="management-icon">📅</div>

                <div>
                    <h3>Events</h3>

                    <p>
                        Manage all campus events.
                    </p>
                </div>

                <span>→</span>

            </a>


            <!-- Event Approvals -->
            <a asp-controller="SuperAdmin"
               asp-action="EventApprovals"
               class="management-card">

                <div class="management-icon">✅</div>

                <div>
                    <h3>Event Approvals</h3>

                    <p>
                        Review and approve submitted events.
                    </p>
                </div>

                <span>→</span>

            </a>


            <!-- Organizations -->
            <a asp-controller="SuperAdmin"
               asp-action="Organizations"
               class="management-card">

                <div class="management-icon">🏢</div>

                <div>
                    <h3>Organizations</h3>

                    <p>
                        Manage clubs and campus organizations.
                    </p>
                </div>

                <span>→</span>

            </a>


            <!-- Departments -->
            <a asp-controller="SuperAdmin"
               asp-action="Departments"
               class="management-card">

                <div class="management-icon">🏫</div>

                <div>
                    <h3>Departments</h3>

                    <p>
                        Manage university departments.
                    </p>
                </div>

                <span>→</span>

            </a>


            <!-- Faculties -->
            <a asp-controller="SuperAdmin"
               asp-action="Faculties"
               class="management-card">

                <div class="management-icon">🎓</div>

                <div>
                    <h3>Faculties</h3>

                    <p>
                        Manage university faculties.
                    </p>
                </div>

                <span>→</span>

            </a>


            <!-- Venues -->
            <a asp-controller="SuperAdmin"
               asp-action="Venues"
               class="management-card">

                <div class="management-icon">📍</div>

                <div>
                    <h3>Venues</h3>

                    <p>
                        Manage campus event locations.
                    </p>
                </div>

                <span>→</span>

            </a>


            <!-- Announcements -->
            <a asp-controller="SuperAdmin"
               asp-action="Announcements"
               class="management-card">

                <div class="management-icon">📢</div>

                <div>
                    <h3>Announcements</h3>

                    <p>
                        Manage university announcements.
                    </p>
                </div>

                <span>→</span>

            </a>


            <!-- Reports -->
            <a asp-controller="SuperAdmin"
               asp-action="Reports"
               class="management-card">

                <div class="management-icon">📊</div>

                <div>
                    <h3>Reports</h3>

                    <p>
                        Review platform reports and statistics.
                    </p>
                </div>

                <span>→</span>

            </a>


            <!-- User Suspensions -->
            <a asp-controller="SuperAdmin"
               asp-action="UserSuspensions"
               class="management-card">

                <div class="management-icon">🚫</div>

                <div>
                    <h3>User Suspensions</h3>

                    <p>
                        Manage suspended user accounts.
                    </p>
                </div>

                <span>→</span>

            </a>


            <!-- System Settings -->
            <a asp-controller="SuperAdmin"
               asp-action="SystemSettings"
               class="management-card">

                <div class="management-icon">⚙️</div>

                <div>
                    <h3>System Settings</h3>

                    <p>
                        Configure HUCEMS system settings.
                    </p>
                </div>

                <span>→</span>

            </a>


            <!-- Audit Logs -->
            <a asp-controller="SuperAdmin"
               asp-action="AuditLogs"
               class="management-card">

                <div class="management-icon">📋</div>

                <div>
                    <h3>Audit Logs</h3>

                    <p>
                        Monitor important system activities.
                    </p>
                </div>

                <span>→</span>

            </a>


            <!-- Database -->
            <a asp-controller="SuperAdmin"
               asp-action="DatabaseManagement"
               class="management-card">

                <div class="management-icon">🗄️</div>

                <div>
                    <h3>Database Management</h3>

                    <p>
                        Monitor database and system information.
                    </p>
                </div>

                <span>→</span>

            </a>

        </div>

    </section>

</div>
