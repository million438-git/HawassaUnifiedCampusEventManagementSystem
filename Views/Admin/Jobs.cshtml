@model HawassaUnifiedCampusEventManagementSystem.Models.AdminJobsViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Job & Career Management";
}

<div class="admin-page-header d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 fw-bold text-dark mb-1">💼 Job & Career Management</h1>
        <p class="text-muted small mb-0">Review campus job postings, internships, employer opportunities, and career fairs.</p>
    </div>
</div>

<!-- =======================================================
     METRICS
     ======================================================= -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="admin-stat-card">
            <div class="stat-icon-box bg-primary-subtle text-primary"><i class="bi bi-briefcase"></i></div>
            <div>
                <div class="stat-num">@Model.TotalCount</div>
                <div class="stat-desc">Total Job Postings</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="admin-stat-card">
            <div class="stat-icon-box bg-success-subtle text-success"><i class="bi bi-check-circle"></i></div>
            <div>
                <div class="stat-num">@Model.ActiveCount</div>
                <div class="stat-desc">Active Postings</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="admin-stat-card">
            <div class="stat-icon-box bg-danger-subtle text-danger"><i class="bi bi-clock-history"></i></div>
            <div>
                <div class="stat-num">@Model.ExpiredCount</div>
                <div class="stat-desc">Expired Postings</div>
            </div>
        </div>
    </div>
</div>

<!-- =======================================================
     JOBS TABLE
     ======================================================= -->
<div class="admin-card overflow-hidden">
    <div class="table-responsive">
        <table class="table admin-table" id="jobsTable">
            <thead>
                <tr>
                    <th>Job Title</th>
                    <th>Employer</th>
                    <th>Type</th>
                    <th>Location</th>
                    <th>Deadline</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var job in Model.Jobs)
                {
                    <tr>
                        <td class="fw-bold text-dark">@job.Title</td>
                        <td>@job.EmployerName</td>
                        <td><span class="badge bg-secondary-subtle text-secondary">@job.JobType</span></td>
                        <td><small class="text-muted"><i class="bi bi-geo-alt me-1"></i>@(job.Location ?? "Hawassa / Remote")</small></td>
                        <td>
                            <small class="text-muted">@(job.ApplicationDeadline.HasValue ? job.ApplicationDeadline.Value.ToString("MMM dd, yyyy") : "Open")</small>
                        </td>
                        <td>
                            @if (job.Status == "ACTIVE")
                            {
                                <span class="badge-status badge-active">Active</span>
                            }
                            else
                            {
                                <span class="badge-status badge-suspended">@job.Status</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1">
                                @if (job.Status != "ACTIVE")
                                {
                                    <form asp-controller="Admin" asp-action="JobApprove" asp-route-id="@job.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-success py-1 px-2" title="Approve">
                                            <i class="bi bi-check-lg"></i>
                                        </button>
                                    </form>
                                }
                                <form asp-controller="Admin" asp-action="JobDelete" asp-route-id="@job.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this job posting?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-light border text-danger py-1 px-2" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
