@model HawassaUnifiedCampusEventManagementSystem.Models.AdminStudyGroupsViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Study Group Management";
}

<div class="admin-page-header d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 fw-bold text-dark mb-1">📚 Study Group Management</h1>
        <p class="text-muted small mb-0">Oversee peer study circles, course discussion hubs, and active collaborative pods.</p>
    </div>
</div>

<!-- =======================================================
     METRICS
     ======================================================= -->
<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="admin-stat-card">
            <div class="stat-icon-box bg-primary-subtle text-primary"><i class="bi bi-book"></i></div>
            <div>
                <div class="stat-num">@Model.TotalCount</div>
                <div class="stat-desc">Total Study Groups</div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="admin-stat-card">
            <div class="stat-icon-box bg-success-subtle text-success"><i class="bi bi-check-circle"></i></div>
            <div>
                <div class="stat-num">@Model.ActiveCount</div>
                <div class="stat-desc">Active Academic Groups</div>
            </div>
        </div>
    </div>
</div>

<!-- =======================================================
     STUDY GROUPS TABLE
     ======================================================= -->
<div class="admin-card overflow-hidden">
    <div class="table-responsive">
        <table class="table admin-table" id="studyGroupsTable">
            <thead>
                <tr>
                    <th>Group Name</th>
                    <th>Course Code</th>
                    <th>Department</th>
                    <th>Group Leader</th>
                    <th>Members</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var g in Model.StudyGroups)
                {
                    <tr>
                        <td class="fw-bold text-dark">@g.Name</td>
                        <td><span class="badge bg-secondary-subtle text-secondary font-monospace">@g.CourseCode</span></td>
                        <td><small class="text-muted">@g.DepartmentName</small></td>
                        <td><small class="fw-semibold text-dark">@g.LeaderName</small></td>
                        <td>
                            <span class="badge bg-light text-dark border">@g.MemberCount / @g.MaxMembers</span>
                        </td>
                        <td>
                            @if (g.Status == "ACTIVE")
                            {
                                <span class="badge-status badge-active">Active</span>
                            }
                            else
                            {
                                <span class="badge-status badge-suspended">@g.Status</span>
                            }
                        </td>
                        <td class="text-end">
                            <form asp-controller="Admin" asp-action="StudyGroupToggleStatus" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@g.Id" />
                                <input type="hidden" name="status" value="@(g.Status == "ACTIVE" ? "SUSPENDED" : "ACTIVE")" />
                                <button type="submit" class="btn btn-sm btn-light border py-1 px-2">
                                    @(g.Status == "ACTIVE" ? "Suspend" : "Activate")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
