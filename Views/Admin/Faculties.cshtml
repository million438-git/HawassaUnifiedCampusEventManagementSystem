@model HawassaUnifiedCampusEventManagementSystem.Models.AdminFacultiesViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Faculty Management";
}

<div class="admin-page-header d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 fw-bold text-dark mb-1">🏛️ Faculty Management</h1>
        <p class="text-muted small mb-0">Manage university faculties, colleges, institute divisions, and dean administration.</p>
    </div>
    <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1 shadow-sm" data-bs-toggle="modal" data-bs-target="#newFacultyModal">
        <i class="bi bi-plus-lg"></i>
        <span>Add Faculty</span>
    </button>
</div>

<!-- =======================================================
     FACULTIES TABLE
     ======================================================= -->
<div class="admin-card overflow-hidden">
    <div class="table-responsive">
        <table class="table admin-table" id="facultiesTable">
            <thead>
                <tr>
                    <th>Faculty / College Name</th>
                    <th>Code</th>
                    <th>Dean of Faculty</th>
                    <th>Official Email</th>
                    <th>Departments</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var f in Model.Faculties)
                {
                    <tr>
                        <td class="fw-bold text-dark">@f.Name</td>
                        <td><span class="badge bg-secondary-subtle text-secondary font-monospace">@(f.Code ?? "N/A")</span></td>
                        <td>@(f.DeanName ?? "Not Assigned")</td>
                        <td class="text-muted small">@(f.Email ?? "N/A")</td>
                        <td>
                            <span class="badge bg-primary-subtle text-primary">@f.DepartmentCount Departments</span>
                        </td>
                        <td>
                            @if (f.IsActive)
                            {
                                <span class="badge-status badge-active">Active</span>
                            }
                            else
                            {
                                <span class="badge-status badge-suspended">Inactive</span>
                            }
                        </td>
                        <td class="text-end">
                            <form asp-controller="Admin" asp-action="FacultyDelete" asp-route-id="@f.Id" method="post" class="d-inline" onsubmit="return confirm('Delete faculty?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-light border text-danger py-1 px-2" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- =======================================================
     ADD FACULTY MODAL
     ======================================================= -->
<div class="modal fade" id="newFacultyModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">🏛️ Add University Faculty</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Admin" asp-action="FacultyCreate" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Faculty / College Name</label>
                        <input type="text" name="name" class="form-control form-control-sm" required placeholder="e.g. Faculty of Informatics & Technology" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Faculty Code</label>
                        <input type="text" name="code" class="form-control form-control-sm" placeholder="e.g. FIT" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Dean Name</label>
                        <input type="text" name="deanName" class="form-control form-control-sm" placeholder="e.g. Dr. Martha Tadesse" />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Email</label>
                            <input type="email" name="email" class="form-control form-control-sm" placeholder="dean.fit@hawassa.edu.et" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Phone</label>
                            <input type="tel" name="phone" class="form-control form-control-sm" placeholder="+251 46 XXX XXXX" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-primary px-3">Add Faculty</button>
                </div>
            </form>
        </div>
    </div>
</div>
