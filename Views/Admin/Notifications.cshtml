@model HawassaUnifiedCampusEventManagementSystem.Models.AdminNotificationsViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Notification Management";
}

<div class="admin-page-header d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 fw-bold text-dark mb-1">🔔 Notification Management & Broadcasts</h1>
        <p class="text-muted small mb-0">Send instant campus alerts, broadcast event notices, and manage push communications.</p>
    </div>
    <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1 shadow-sm" data-bs-toggle="modal" data-bs-target="#broadcastNotificationModal">
        <i class="bi bi-send"></i>
        <span>Send Broadcast</span>
    </button>
</div>

<!-- =======================================================
     NOTIFICATION HISTORY TABLE
     ======================================================= -->
<div class="admin-card overflow-hidden">
    <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
        <h2 class="h6 fw-bold text-dark mb-0"><i class="bi bi-clock-history me-2 text-primary"></i>Broadcast History</h2>
        <span class="badge bg-light text-secondary border">@Model.TotalSent Total Dispatches</span>
    </div>
    <div class="table-responsive">
        <table class="table admin-table" id="notificationsTable">
            <thead>
                <tr>
                    <th>Title & Notification Message</th>
                    <th>Target Audience</th>
                    <th>Type</th>
                    <th>Sent Timestamp</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var n in Model.Notifications)
                {
                    <tr>
                        <td>
                            <div class="fw-bold text-dark">@n.Title</div>
                            <small class="text-muted">@n.Message</small>
                        </td>
                        <td><span class="badge bg-secondary-subtle text-secondary">@n.TargetAudience</span></td>
                        <td><span class="badge bg-primary-subtle text-primary">@n.Type</span></td>
                        <td class="small text-muted">@n.CreatedAt.ToString("MMM dd, yyyy hh:mm tt")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- =======================================================
     BROADCAST MODAL
     ======================================================= -->
<div class="modal fade" id="broadcastNotificationModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">🔔 Broadcast Campus Notification</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Admin" asp-action="NotificationSend" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Alert Title</label>
                        <input type="text" name="title" class="form-control form-control-sm" required placeholder="e.g. Schedule Update: African Hall Auditorium" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Message</label>
                        <textarea name="message" rows="4" class="form-control form-control-sm" required placeholder="Type the alert message to be delivered to user notification feeds..."></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Target Audience</label>
                        <select name="targetAudience" class="form-select form-select-sm">
                            <option value="ALL">All Campus Members (Broad)</option>
                            <option value="STUDENTS">Students Only</option>
                            <option value="FACULTY">Faculty & Staff Only</option>
                            <option value="ORGANIZERS">Club Leaders & Organizers</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-primary px-3"><i class="bi bi-send me-1"></i>Dispatch Alert</button>
                </div>
            </form>
        </div>
    </div>
</div>
