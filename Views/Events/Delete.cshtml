@{
    ViewData["Title"] = "Delete Event";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow-sm border-0">

                <div class="card-header bg-danger text-white py-3">

                    <h3 class="mb-0">
                        <i class="bi bi-trash3"></i>
                        Delete Event
                    </h3>

                </div>

                <div class="card-body p-4">

                    <div class="alert alert-warning">

                        <i class="bi bi-exclamation-triangle-fill"></i>

                        <strong>Warning!</strong>

                        Are you sure you want to delete this event?

                        <br />

                        This action cannot be easily undone.

                    </div>


                    <!-- EVENT INFORMATION -->

                    <div class="event-delete-information">

                        <h4 class="mb-3">
                            Event Information
                        </h4>

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <strong>
                                    Event Title
                                </strong>

                                <p class="text-muted">
                                    @ViewBag.EventTitle
                                </p>

                            </div>


                            <div class="col-md-6 mb-3">

                                <strong>
                                    Event Category
                                </strong>

                                <p class="text-muted">
                                    @ViewBag.EventCategory
                                </p>

                            </div>


                            <div class="col-md-6 mb-3">

                                <strong>
                                    Date
                                </strong>

                                <p class="text-muted">
                                    @ViewBag.EventDate
                                </p>

                            </div>


                            <div class="col-md-6 mb-3">

                                <strong>
                                    Location
                                </strong>

                                <p class="text-muted">
                                    @ViewBag.EventLocation
                                </p>

                            </div>

                        </div>

                    </div>


                    <hr />


                    <!-- DELETE FORM -->

                    <form asp-action="Delete"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@ViewBag.EventId" />


                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-danger">

                                <i class="bi bi-trash3"></i>

                                Yes, Delete Event

                            </button>


                            <a asp-action="Index"
                               class="btn btn-secondary">

                                <i class="bi bi-arrow-left"></i>

                                Cancel

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>