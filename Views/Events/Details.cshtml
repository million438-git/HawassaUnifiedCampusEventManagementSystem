@model HawassaUnifiedCampusEventManagementSystem.Models.Event

@{
    ViewData["Title"] = "Event Details";
}

@section Styles {

    <link rel="stylesheet"
          href="~/css/events.css"
          asp-append-version="true" />

}

<div class="event-details-page">

    <div class="container">

        <a asp-controller="Events"
           asp-action="Index"
           class="event-back-link">

            <i class="bi bi-arrow-left"></i>

            Back to Events

        </a>


        <div class="event-details-card">

            <div class="event-details-date">

                <span>
                    @Model.EventDate.ToString("MMMM")
                </span>

                <strong>
                    @Model.EventDate.Day
                </strong>

                <small>
                    @Model.EventDate.ToString("dddd")
                </small>

            </div>


            <div class="event-details-content">

                <span class="event-category">
                    @Model.Category
                </span>


                <h1>
                    @Model.Title
                </h1>


                <p class="event-details-description">
                    @Model.Description
                </p>


                <div class="event-information-grid">

                    <div class="event-information-item">
                        <i class="bi bi-calendar3"></i>
                        <div>
                            <small>Date</small>
                            <strong>@Model.EventDate.ToString("MMMM dd, yyyy")</strong>
                        </div>
                    </div>

                    <div class="event-information-item">
                        <i class="bi bi-clock"></i>
                        <div>
                            <small>Time</small>
                            <strong>
                                @Model.StartTime.ToString(@"hh\:mm")
                                @if (Model.EndTime.HasValue)
                                {
                                    <span> - @Model.EndTime.Value.ToString(@"hh\:mm")</span>
                                }
                            </strong>
                        </div>
                    </div>

                    <div class="event-information-item">
                        <i class="bi bi-geo-alt"></i>
                        <div>
                            <small>Venue</small>
                            <strong>@Model.Venue</strong>
                        </div>
                    </div>

                    <div class="event-information-item">
                        <i class="bi bi-people"></i>
                        <div>
                            <small>Capacity</small>
                            <strong>@(Model.Capacity.HasValue ? $"{Model.Capacity} people" : "Open")</strong>
                        </div>
                    </div>

                    <div class="event-information-item">
                        <i class="bi bi-person-badge"></i>
                        <div>
                            <small>Organizer</small>
                            <strong>@Model.Organizer</strong>
                        </div>
                    </div>

                    <div class="event-information-item">
                        <i class="bi bi-envelope"></i>
                        <div>
                            <small>Contact</small>
                            <strong>@Model.OrganizerEmail</strong>
                        </div>
                    </div>

                </div>

                @if (Model.ApprovalStatus == "PENDING")
                {
                    <div class="alert alert-warning d-flex align-items-center gap-2 my-3 rounded-3">
                        <i class="bi bi-hourglass-split fs-5"></i>
                        <div>
                            <strong>Pending Administrative Approval:</strong> This event has been submitted and is currently being reviewed by Campus Administration.
                        </div>
                    </div>
                }

                <!-- ATTENDEE REGISTRATION BAR -->
                <div class="p-3 bg-light rounded-3 border d-flex flex-column flex-md-row justify-content-between align-items-center gap-3 my-4">
                    <div>
                        <div class="fw-bold text-dark">
                            <i class="bi bi-ticket-detailed me-1 text-primary"></i> Attendance: @Model.RegisteredCount @(Model.Capacity.HasValue ? $" / {Model.Capacity.Value} capacity" : "registered")
                        </div>
                        <small class="text-muted">
                            @(Model.Capacity.HasValue && Model.RegisteredCount >= Model.Capacity.Value ? "Event is at capacity (waitlist available)" : "Open for university registration")
                        </small>
                    </div>

                    <div>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            if (Model.IsUserRegistered)
                            {
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-success py-2 px-3"><i class="bi bi-check-circle me-1"></i> You are Registered</span>
                                    <form asp-controller="Events" asp-action="CancelRegistration" asp-route-id="@Model.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to cancel your registration?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger btn-sm">
                                            Cancel
                                        </button>
                                    </form>
                                </div>
                            }
                            else
                            {
                                <form asp-controller="Events" asp-action="RegisterEvent" asp-route-id="@Model.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-primary px-4 fw-semibold">
                                        <i class="bi bi-ticket-perforated me-1"></i> Register for Event
                                    </button>
                                </form>
                            }
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Details", "Events", new { id = Model.Id })" class="btn btn-primary px-4">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Sign In to Register
                            </a>
                        }
                    </div>
                </div>

                @{
                    var currentUserIdStr = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                    ulong? currentUserId = null;
                    if (!string.IsNullOrEmpty(currentUserIdStr) && ulong.TryParse(currentUserIdStr, out ulong uid)) currentUserId = uid;
                    var canManageEvent = (currentUserId.HasValue && Model.OrganizerId == currentUserId.Value) || 
                                         User.IsInRole("Admin") || User.IsInRole("SuperAdmin") || 
                                         User.IsInRole("ADMIN") || User.IsInRole("SUPERADMIN");
                }

                @if (canManageEvent)
                {
                    <div class="event-details-actions mt-3">
                        <a asp-controller="Events" asp-action="Edit" asp-route-id="@Model.Id" class="event-edit-button">
                            <i class="bi bi-pencil"></i> Edit Event
                        </a>
                        <form asp-controller="Events" asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this event?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="event-delete-button">
                                <i class="bi bi-trash"></i> Delete
                            </button>
                        </form>
                    </div>
                }

            </div>

        </div>

    </div>

</div>