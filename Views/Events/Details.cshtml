@model HawassaUnifiedCampusEventManagementSystem.Models.Event

@{
    ViewData["Title"] = "Event Details";
}

@section Styles {

    <link rel="stylesheet"
          href="~/css/events.css"
          asp-append-version="true" />

}

<div class="event-details-page">

    <div class="container">

        <a asp-controller="Events"
           asp-action="Index"
           class="event-back-link">

            <i class="bi bi-arrow-left"></i>

            Back to Events

        </a>


        <div class="event-details-card">

            <div class="event-details-date">

                <span>
                    @Model.EventDate.ToString("MMMM")
                </span>

                <strong>
                    @Model.EventDate.Day
                </strong>

                <small>
                    @Model.EventDate.ToString("dddd")
                </small>

            </div>


            <div class="event-details-content">

                <span class="event-category">
                    @Model.Category
                </span>


                <h1>
                    @Model.Title
                </h1>


                <p class="event-details-description">
                    @Model.Description
                </p>


                <div class="event-information-grid">


                    <div class="event-information-item">

                        <i class="bi bi-calendar3"></i>

                        <div>

                            <small>
                                Date
                            </small>

                            <strong>
                                @Model.EventDate.ToString("MMMM dd, yyyy")
                            </strong>

                        </div>

                    </div>


                    <div class="event-information-item">

                        <i class="bi bi-clock"></i>

                        <div>

                            <small>
                                Time
                            </small>

                            <strong>

                                @Model.StartTime.ToString(@"hh\:mm")

                                @if (Model.EndTime.HasValue)
                                {
                                    <span>
                                        -
                                        @Model.EndTime.Value.ToString(@"hh\:mm")
                                    </span>
                                }

                            </strong>

                        </div>

                    </div>


                    <div class="event-information-item">

                        <i class="bi bi-geo-alt"></i>

                        <div>

                            <small>
                                Venue
                            </small>

                            <strong>
                                @Model.Venue
                            </strong>

                        </div>

                    </div>


                    <div class="event-information-item">

                        <i class="bi bi-people"></i>

                        <div>

                            <small>
                                Capacity
                            </small>

                            <strong>
                                @Model.Capacity people
                            </strong>

                        </div>

                    </div>


                    <div class="event-information-item">

                        <i class="bi bi-person-badge"></i>

                        <div>

                            <small>
                                Organizer
                            </small>

                            <strong>
                                @Model.Organizer
                            </strong>

                        </div>

                    </div>


                    <div class="event-information-item">

                        <i class="bi bi-envelope"></i>

                        <div>

                            <small>
                                Contact
                            </small>

                            <strong>
                                @Model.OrganizerEmail
                            </strong>

                        </div>

                    </div>

                </div>


                <div class="event-details-actions">

                    <a asp-controller="Events"
                       asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="event-edit-button">

                        <i class="bi bi-pencil"></i>

                        Edit Event

                    </a>


                    <form asp-controller="Events"
                          asp-action="Delete"
                          asp-route-id="@Model.Id"
                          method="post"
                          onsubmit="return confirm('Are you sure you want to delete this event?');">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="event-delete-button">

                            <i class="bi bi-trash"></i>

                            Delete

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>