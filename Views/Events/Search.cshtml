@{
    ViewData["Title"] = "Search Events";
}

<div class="container py-5">

    <!-- PAGE HEADER -->

    <div class="text-center mb-5">

        <div class="mb-3">

            <i class="bi bi-search display-4 text-primary"></i>

        </div>

        <h1 class="fw-bold">
            Search Events
        </h1>

        <p class="text-muted">
            Find campus events by title, category,
            location, or description.
        </p>

    </div>


    <!-- SEARCH BOX -->

    <div class="card border-0 shadow-sm mb-5">

        <div class="card-body p-4">

            <form asp-action="Search"
                  method="get">

                <div class="row g-3">

                    <div class="col-lg-8">

                        <label class="form-label fw-semibold">

                            Search

                        </label>

                        <div class="input-group">

                            <span class="input-group-text">

                                <i class="bi bi-search"></i>

                            </span>

                            <input type="text"
                                   name="query"
                                   value="@ViewBag.Query"
                                   class="form-control"
                                   placeholder="Search event title, location, category..." />

                        </div>

                    </div>


                    <div class="col-lg-4 d-flex align-items-end">

                        <button type="submit"
                                class="btn btn-primary w-100">

                            <i class="bi bi-search"></i>

                            Search Events

                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- SEARCH RESULTS -->
    @if (ViewBag.Events != null)
    {

        var events = ViewBag.Events as IEnumerable<dynamic>;

        if (events != null && events.Any())
        {

            <div class="d-flex justify-content-between
                align-items-center mb-3">

                <h3 class="mb-0">

                    Search Results

                </h3>

                <span class="badge bg-primary">

                    @events.Count() results

                </span>

            </div>


            <div class="row g-4">

                @foreach (var item in events)
                {

                    <div class="col-lg-4 col-md-6">

                        <div class="card h-100 shadow-sm border-0">

                            <div class="card-body">

                                <div class="mb-3">

                                    <span class="badge bg-primary">

                                        @item.Category

                                    </span>

                                </div>


                                <h4 class="card-title">

                                    @item.Title

                                </h4>


                                <p class="text-muted">

                                    @item.Description

                                </p>


                                <div class="small text-muted mb-2">

                                    <i class="bi bi-calendar-event"></i>

                                    @item.EventDate

                                </div>


                                <div class="small text-muted mb-3">

                                    <i class="bi bi-geo-alt"></i>

                                    @item.Location

                                </div>


                                <div class="d-flex gap-2">

                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-outline-primary btn-sm">

                                        <i class="bi bi-eye"></i>

                                        Details

                                    </a>


                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-outline-secondary btn-sm">

                                        <i class="bi bi-pencil"></i>

                                        Edit

                                    </a>

                                </div>

                            </div>

                        </div>

                    </div>

                }

            </div>

        }
        else
        {

            <div class="text-center py-5">

                <i class="bi bi-search display-3 text-muted"></i>

                <h3 class="mt-3">
                    No Events Found
                </h3>

                <p class="text-muted">

                    We couldn't find any events matching
                    your search.

                </p>

                <a asp-action="Index"
                   class="btn btn-primary">

                    <i class="bi bi-calendar-event"></i>

                    View All Events

                </a>

            </div>

        }

    }

</div>