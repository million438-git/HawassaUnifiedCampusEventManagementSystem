@model IEnumerable<HawassaUnifiedCampusEventManagementSystem.Models.EventCategorySummaryViewModel>

@{
    ViewData["Title"] = "Campus Event Categories";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/events.css" asp-append-version="true" />
}

<div class="events-page py-5">
    <div class="container">
        <!-- HEADER -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-5 pb-3 border-bottom">
            <div>
                <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill fw-semibold mb-2">
                    <i class="bi bi-grid-3x3-gap-fill me-1"></i> EXPLORE HAWASSA ACTIVITIES
                </span>
                <h1 class="display-6 fw-bold text-dark mb-1">Campus Event Categories</h1>
                <p class="text-muted mb-0">Browse university events by thematic track, academic discipline, and student life interests.</p>
            </div>

            <a asp-controller="Events" asp-action="Index" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                <i class="bi bi-calendar-event me-1"></i> View All Campus Events
            </a>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-5 my-4 bg-light rounded-4 p-5">
                <div class="bg-white p-4 rounded-circle d-inline-block text-muted shadow-sm mb-3" style="width: 80px; height: 80px;">
                    <i class="bi bi-folder-x fs-1 text-secondary"></i>
                </div>
                <h2 class="h5 fw-bold text-dark mb-1">No Active Categories Found</h2>
                <p class="text-muted small mb-3">There are currently no active event categories configured in the campus directory.</p>
                <a asp-controller="Events" asp-action="Index" class="btn btn-primary btn-sm rounded-pill px-4">
                    Explore All Events
                </a>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var category in Model)
                {
                    var iconClass = category.Name.ToLower() switch
                    {
                        var n when n.Contains("tech") || n.Contains("code") => "bi-cpu",
                        var n when n.Contains("bus") || n.Contains("econ") => "bi-briefcase",
                        var n when n.Contains("cult") || n.Contains("art") => "bi-palette",
                        var n when n.Contains("cyber") || n.Contains("sec") => "bi-shield-lock",
                        var n when n.Contains("sport") || n.Contains("game") => "bi-trophy",
                        var n when n.Contains("acad") || n.Contains("sci") => "bi-mortarboard",
                        var n when n.Contains("soc") || n.Contains("comm") => "bi-people",
                        var n when n.Contains("work") || n.Contains("car") => "bi-laptop",
                        _ => string.IsNullOrWhiteSpace(category.Icon) ? "bi-calendar-event" : category.Icon
                    };

                    <div class="col-sm-6 col-lg-4 col-xl-3">
                        <a asp-controller="Events" asp-action="Index" asp-route-category="@category.Name" class="card h-100 border-0 shadow-sm rounded-4 p-4 text-decoration-none transition-all category-card-hover bg-white">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <div class="bg-primary-subtle text-primary p-3 rounded-3 fs-3 d-flex align-items-center justify-content-center" style="width: 56px; height: 56px;">
                                    <i class="bi @iconClass"></i>
                                </div>
                                <span class="badge @(category.EventCount > 0 ? "bg-success-subtle text-success-emphasis" : "bg-light text-muted border") rounded-pill px-3 py-2 fw-semibold small">
                                    @category.EventCount @(category.EventCount == 1 ? "event" : "events")
                                </span>
                            </div>

                            <h2 class="h5 fw-bold text-dark mb-1">@category.Name</h2>

                            @if (!string.IsNullOrWhiteSpace(category.Description))
                            {
                                <p class="text-muted small mb-4 flex-grow-1" style="line-height: 1.5;">
                                    @category.Description
                                </p>
                            }
                            else
                            {
                                <p class="text-muted small mb-4 flex-grow-1">
                                    Discover university activities and opportunities in @category.Name.
                                </p>
                            }

                            <div class="d-flex align-items-center text-primary fw-semibold small mt-auto pt-2 border-top">
                                <span>Browse category</span>
                                <i class="bi bi-arrow-right ms-auto"></i>
                            </div>
                        </a>
                    </div>
                }
            </div>
        }
    </div>
</div>