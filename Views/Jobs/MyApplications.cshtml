@model HawassaUnifiedCampusEventManagementSystem.Models.MyApplicationsViewModel

@{
    ViewData["Title"] = "My Job Applications";
}

@section Styles {
    <link rel="stylesheet" href="~/css/jobs.css" asp-append-version="true" />
}

<div class="jobs-page py-5">
    <div class="container">

        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item"><a asp-controller="Jobs" asp-action="Index">Jobs & Careers</a></li>
                <li class="breadcrumb-item active" aria-current="page">My Applications</li>
            </ol>
        </nav>

        <!-- PAGE HEADER -->
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
            <div>
                <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill fw-bold mb-2">
                    🎓 Student Career Hub
                </span>
                <h1 class="h2 fw-bold text-dark mb-1">My Job Applications</h1>
                <p class="text-muted mb-0">Track the status of your internship, graduate job, and campus applications.</p>
            </div>

            <a asp-controller="Jobs" asp-action="Index" class="btn btn-primary rounded-pill px-4 shadow-sm">
                <i class="bi bi-search me-1"></i> Browse More Jobs
            </a>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-check-circle-fill fs-5 text-success"></i>
                    <div>
                        <strong>Application Received!</strong> @TempData["SuccessMessage"]
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- STATS CARDS -->
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="bg-white p-4 rounded-4 border shadow-sm d-flex align-items-center gap-3">
                    <div class="p-3 bg-primary-subtle text-primary rounded-3 fs-3">
                        <i class="bi bi-send-check"></i>
                    </div>
                    <div>
                        <div class="fs-4 fw-bold text-dark">@Model.TotalApplications</div>
                        <div class="text-muted small">Total Applications</div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="bg-white p-4 rounded-4 border shadow-sm d-flex align-items-center gap-3">
                    <div class="p-3 bg-warning-subtle text-warning rounded-3 fs-3">
                        <i class="bi bi-hourglass-split"></i>
                    </div>
                    <div>
                        <div class="fs-4 fw-bold text-dark">@Model.UnderReviewCount</div>
                        <div class="text-muted small">Under Review</div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="bg-white p-4 rounded-4 border shadow-sm d-flex align-items-center gap-3">
                    <div class="p-3 bg-success-subtle text-success rounded-3 fs-3">
                        <i class="bi bi-patch-check"></i>
                    </div>
                    <div>
                        <div class="fs-4 fw-bold text-dark">@Model.ShortlistedCount</div>
                        <div class="text-muted small">Shortlisted / Interviews</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- APPLICATIONS LIST -->
        <div class="bg-white rounded-4 border shadow-sm overflow-hidden">
            @if (Model.Applications.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4 py-3 text-muted small text-uppercase">Application ID</th>
                                <th class="py-3 text-muted small text-uppercase">Job Title & Employer</th>
                                <th class="py-3 text-muted small text-uppercase">Job Type</th>
                                <th class="py-3 text-muted small text-uppercase">Applied Date</th>
                                <th class="py-3 text-muted small text-uppercase">Status</th>
                                <th class="py-3 text-muted small text-uppercase">Notes / Next Steps</th>
                                <th class="pe-4 py-3 text-end text-muted small text-uppercase">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var app in Model.Applications)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-primary font-monospace small">
                                        @app.ApplicationId
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark">@app.JobTitle</div>
                                        <div class="text-muted small">🏢 @app.CompanyName • 📍 @app.Location</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light border text-dark">@app.JobType</span>
                                    </td>
                                    <td class="text-muted small">
                                        <i class="bi bi-clock me-1"></i> @app.AppliedAt.ToString("MMM dd, yyyy")
                                    </td>
                                    <td>
                                        <span class="badge @app.StatusBadgeClass px-3 py-2 rounded-pill">
                                            @app.Status
                                        </span>
                                    </td>
                                    <td class="text-secondary small" style="max-width: 280px;">
                                        @(app.Notes ?? "Your application is being processed by the recruitment team.")
                                    </td>
                                    <td class="pe-4 text-end">
                                        <a asp-controller="Jobs" asp-action="Details" asp-route-id="@app.JobId" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                            View Job
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 px-3">
                    <i class="bi bi-briefcase text-muted" style="font-size: 3.5rem;"></i>
                    <h5 class="fw-bold mt-3">No applications submitted yet</h5>
                    <p class="text-muted">Start applying for exciting internships, graduate jobs, and campus positions!</p>
                    <a asp-controller="Jobs" asp-action="Index" class="btn btn-primary rounded-pill px-4 mt-2">
                        Explore Available Jobs
                    </a>
                </div>
            }
        </div>

    </div>
</div>
