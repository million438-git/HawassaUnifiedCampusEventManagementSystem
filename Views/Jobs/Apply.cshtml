@model HawassaUnifiedCampusEventManagementSystem.Models.JobApplicationViewModel

@{
    ViewData["Title"] = $"Apply for {Model.JobTitle}";
}

@section Styles {
    <link rel="stylesheet" href="~/css/jobs.css" asp-append-version="true" />
}

<div class="jobs-page py-5">
    <div class="container">
        
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item"><a asp-controller="Jobs" asp-action="Index">Jobs</a></li>
                <li class="breadcrumb-item"><a asp-controller="Jobs" asp-action="Details" asp-route-id="@Model.JobId">@Model.JobTitle</a></li>
                <li class="breadcrumb-item active" aria-current="page">Apply</li>
            </ol>
        </nav>

        <div class="row justify-content-center">
            <div class="col-lg-8">

                <!-- APPLICATION CARD -->
                <div class="bg-white rounded-4 border shadow-sm p-4 p-md-5">

                    <div class="text-center mb-4 pb-3 border-bottom">
                        <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill fw-bold mb-2">
                            🎓 Student Job Application
                        </span>
                        <h2 class="fw-bold text-dark mb-1">@Model.JobTitle</h2>
                        <p class="text-muted mb-0">
                            🏢 <strong>@Model.CompanyName</strong> • 📍 @Model.Location • <span class="badge bg-light border text-dark">@Model.JobType</span>
                        </p>
                    </div>

                    @if (User.Identity?.IsAuthenticated != true)
                    {
                        <div class="alert alert-info d-flex align-items-center gap-3 rounded-3 mb-4" role="alert">
                            <i class="bi bi-info-circle-fill fs-4 text-primary"></i>
                            <div class="small">
                                <strong>Applying as a Guest?</strong> You can complete this application form directly, or 
                                <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Apply", "Jobs", new { id = Model.JobId })" class="alert-link fw-bold">Sign In</a> 
                                to automatically link this submission to your HUCEMS Student Account.
                            </div>
                        </div>
                    }

                    <form asp-controller="Jobs" asp-action="Apply" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="JobId" />
                        <input type="hidden" asp-for="JobTitle" />
                        <input type="hidden" asp-for="CompanyName" />
                        <input type="hidden" asp-for="Location" />
                        <input type="hidden" asp-for="JobType" />

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <!-- SECTION 1: PERSONAL DETAILS -->
                        <h5 class="fw-bold text-dark mb-3"><i class="bi bi-person me-2 text-primary"></i>Personal Information</h5>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="FullName" class="form-label fw-semibold small"></label>
                                <input asp-for="FullName" class="form-control rounded-3" placeholder="e.g. Abebe Kebede" required />
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-semibold small"></label>
                                <input asp-for="Email" type="email" class="form-control rounded-3" placeholder="e.g. student@hu.edu.et" required />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label fw-semibold small"></label>
                                <input asp-for="Phone" type="tel" class="form-control rounded-3" placeholder="e.g. +251 91 234 5678" required />
                                <span asp-validation-for="Phone" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="StudentId" class="form-label fw-semibold small"></label>
                                <input asp-for="StudentId" class="form-control rounded-3" placeholder="e.g. R/1234/14 (Optional)" />
                                <span asp-validation-for="StudentId" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- SECTION 2: ACADEMIC DETAILS -->
                        <h5 class="fw-bold text-dark mb-3"><i class="bi bi-mortarboard me-2 text-primary"></i>Academic Background</h5>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="Department" class="form-label fw-semibold small"></label>
                                <select asp-for="Department" class="form-select rounded-3">
                                    <option value="Computer Science & IT">Computer Science & IT</option>
                                    <option value="Software Engineering">Software Engineering</option>
                                    <option value="Electrical & Computer Engineering">Electrical & Computer Engineering</option>
                                    <option value="Information Systems">Information Systems</option>
                                    <option value="Mechanical / Mechatronics">Mechanical / Mechatronics</option>
                                    <option value="Accounting & Finance">Accounting & Finance</option>
                                    <option value="Economics & Management">Economics & Management</option>
                                    <option value="Agriculture & Plant Sciences">Agriculture & Plant Sciences</option>
                                    <option value="Medicine & Health Sciences">Medicine & Health Sciences</option>
                                    <option value="Other Department">Other Department</option>
                                </select>
                            </div>

                            <div class="col-md-3">
                                <label asp-for="YearOfStudy" class="form-label fw-semibold small"></label>
                                <select asp-for="YearOfStudy" class="form-select rounded-3">
                                    <option value="2nd Year">2nd Year</option>
                                    <option value="3rd Year" selected>3rd Year</option>
                                    <option value="4th Year">4th Year</option>
                                    <option value="5th Year">5th Year</option>
                                    <option value="Fresh Graduate">Fresh Graduate</option>
                                </select>
                            </div>

                            <div class="col-md-3">
                                <label asp-for="Gpa" class="form-label fw-semibold small"></label>
                                <input asp-for="Gpa" class="form-control rounded-3" placeholder="e.g. 3.75" />
                            </div>

                            <div class="col-12">
                                <label asp-for="PortfolioUrl" class="form-label fw-semibold small"></label>
                                <input asp-for="PortfolioUrl" class="form-control rounded-3" placeholder="https://github.com/your-username or portfolio link" />
                                <span asp-validation-for="PortfolioUrl" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- SECTION 3: STATEMENT / COVER LETTER -->
                        <h5 class="fw-bold text-dark mb-3"><i class="bi bi-file-earmark-text me-2 text-primary"></i>Statement of Interest & CV</h5>
                        <div class="mb-4">
                            <label asp-for="CoverLetter" class="form-label fw-semibold small"></label>
                            <textarea asp-for="CoverLetter" rows="5" class="form-control rounded-3" placeholder="Briefly describe why you are interested in this position and why your background matches the requirements..." required></textarea>
                            <span asp-validation-for="CoverLetter" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold small">Upload Resume / CV (PDF or DOCX)</label>
                            <input type="file" name="resumeFile" class="form-control rounded-3" accept=".pdf,.docx,.doc" />
                            <small class="text-muted">Maximum file size: 5MB. PDF format recommended.</small>
                        </div>

                        <div class="form-check mb-4">
                            <input class="form-check-input" type="checkbox" asp-for="AgreeToTerms" id="agreeCheck" required />
                            <label class="form-check-label small text-muted" for="agreeCheck">
                                I confirm that the information provided is accurate and I authorize the employer to review my academic and contact records.
                            </label>
                        </div>

                        <div class="d-flex flex-column flex-sm-row gap-3 pt-2">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5 shadow-sm">
                                <i class="bi bi-send-fill me-1"></i> Submit Application
                            </button>
                            <a asp-controller="Jobs" asp-action="Index" class="btn btn-outline-secondary btn-lg rounded-pill px-4">
                                Cancel
                            </a>
                        </div>

                    </form>

                </div>

            </div>
        </div>

    </div>
</div>
